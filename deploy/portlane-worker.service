[Unit]
Description=Portlane delivery/forward workers (BullMQ)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portlane
WorkingDirectory=/opt/portlane
EnvironmentFile=/etc/portlane/portlane.env
ExecStart=/usr/bin/node /opt/portlane/apps/api/dist/worker.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
