# Portlane prod env — salin ke /etc/portlane/portlane.env (chmod 600, owner portlane)
# Jangan commit file terisi. Generate: openssl rand -hex 32
APP_ENV=production
APP_PORT=4002
LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id
TRUSTED_PROXIES=
DATABASE_URL=postgresql://USER:PASS@YOUR_TAILSCALE_IP:5432/portlane
REDIS_URL=redis://YOUR_TAILSCALE_IP:6379
APP_ENCRYPTION_KEY=PASTE_64_HEX
JWT_SECRET=PASTE_64_HEX_BEDA_DARI_ENCRYPTION_KEY
JWT_EXPIRES_IN=7d
# Cookie sesi dashboard: auto = Secure hanya bila APP_ENV=production.
# Set false bila akses via HTTP polos di jaringan privat (tailscale) —
# browser membuang cookie Secure di atas HTTP (login sukses tapi sesi
# tak menempel / "Missing token"). Wajib true bila ekspos HTTPS/internet.
COOKIE_SECURE=false
