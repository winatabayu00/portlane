# Portlane env — M00 foundation (minisever via Tailscale, tanpa Docker)
#
# Copy ke .env dan isi dari kredensial minisever:
#   cp .env.example .env
# Real secrets TIDAK boleh di-commit.

# ---- App ----
APP_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# ID publik API untuk correlation header. Default: x-request-id.
REQUEST_ID_HEADER=x-request-id

# Explicit trusted proxy. Kosong = jangan percaya forwarding headers.
# Contoh Tailscale: TRUSTED_PROXIES=100.64.0.0/10
TRUSTED_PROXIES=

# ---- Database (Postgres di minisever, via Tailscale) ----
# Contoh: postgres://portlane:SECRET@100.x.y.z:5432/portlane
DATABASE_URL=

# ---- Redis (minisever, via Tailscale) ----
# Contoh: redis://100.x.y.z:6379
REDIS_URL=

# ---- Crypto (dibutuhkan milestone berikutnya; disiapkan sekarang) ----
# 32-byte hex/base64. Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=
